<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833). -->
<!-- Local change for this TV: Urbanist (OFL, launcher/URBANIST-LICENSE-OFL.txt) instead of Outfit. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/urbanist_regular</string>
    <string name="font_regular" translatable="false">@font/urbanist_regular</string>
    <string name="font_light" translatable="false">@font/urbanist_light</string>
    <string name="font_extralight" translatable="false">@font/urbanist_extralight</string>
    <string name="font_medium" translatable="false">@font/urbanist_medium</string>
</resources>
